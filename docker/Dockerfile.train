# Training image: pinned CUDA base; dependencies from the lockfile. torchrun-ready.
FROM nvcr.io/nvidia/pytorch:24.08-py3
WORKDIR /workspace
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
# The base image ships CUDA torch; install the rest without replacing it.
RUN uv pip install --system --no-cache ".[train,mlops]" --no-deps \
    && uv pip install --system --no-cache timm albumentations pandas pyarrow scikit-learn scikit-image \
       imagehash onnx onnxscript onnxruntime pydicom pydantic pyyaml mlflow "dvc[s3]"
COPY configs/ configs/
COPY scripts/gpu_benchmark.py scripts/
# Run with --shm-size (or --ipc=host): DataLoader workers pass batches through /dev/shm,
# and Docker's 64 MB default crashes num_workers=8 at 768 px ("bus error").
ENTRYPOINT ["torchrun", "--nproc_per_node=gpu", "-m", "xrayml.cli"]
CMD ["train", "configs/detection_fracatlas.yaml"]
